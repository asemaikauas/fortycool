FORTYGUARD_API_KEY=replace-with-your-fortyguard-key
FORTYCOOL_THERMAL_PROVIDER=fixture
FORTYCOOL_URBAN_PROVIDER=fixture
EARTH_ENGINE_PROJECT=replace-with-your-google-cloud-project
OPENAI_API_KEY=replace-with-your-openai-key
FORTYCOOL_COPILOT_MODEL=gpt-4o
# Heroku supplies this automatically when Postgres is attached. Local runs
# should normally omit it and use the SQLite fallback instead.
DATABASE_URL=postgresql://localhost/fortycool
FORTYCOOL_CORS_ORIGINS=http://localhost:8000
# Set this only on the Vercel frontend service when its API is on another host.
FORTYCOOL_PUBLIC_API_BASE=https://your-backend.example.com
